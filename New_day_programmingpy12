# ------------------------------------------------------------
# Problem Statement:
# Given an array nums of size n, rotate the array to the right
# by k steps, where k is non-negative.
#
# You must do this in-place with O(1) extra space.
#
# Example:
# nums = [1,2,3,4,5,6,7], k = 3
# Output: [5,6,7,1,2,3,4]
#
# Constraints:
# - 1 <= n <= 10^5
# - -10^9 <= nums[i] <= 10^9
# - 0 <= k <= 10^5
#
# Time Complexity: O(n)
# Space Complexity: O(1)
# ------------------------------------------------------------

def rotate_array(nums, k):
    n = len(nums)
    k = k % n

    def reverse(start, end):
        while start < end:
            nums[start], nums[end] = nums[end], nums[start]
            start += 1
            end -= 1

    reverse(0, n - 1)
    reverse(0, k - 1)
    reverse(k, n - 1)


# Example usage
nums = [1, 2, 3, 4, 5, 6, 7]
k = 3

rotate_array(nums, k)
print(nums)
