"""
High-Level Array Problem:
Longest Subarray with Sum = K
Time Complexity: O(n)
Space Complexity: O(n)
"""

def longest_subarray_with_sum_k(arr, k):
    prefix_sum_map = {}
    current_sum = 0
    max_length = 0

    for i in range(len(arr)):
        current_sum += arr[i]

        # Case 1: If sum equals k from start
        if current_sum == k:
            max_length = i + 1

        # Case 2: If (current_sum - k) seen before
        if (current_sum - k) in prefix_sum_map:
            length = i - prefix_sum_map[current_sum - k]
            max_length = max(max_length, length)

        # Store first occurrence only
        if current_sum not in prefix_sum_map:
            prefix_sum_map[current_sum] = i

    return max_length


# Example usage
arr = list(map(int, input("Enter array elements: ").split()))
k = int(input("Enter target sum K: "))

result = longest_subarray_with_sum_k(arr, k)

print("Length of longest subarray:", result)
