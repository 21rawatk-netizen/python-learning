"""
High-Level Array Problem:
Trapping Rain Water
Time Complexity: O(n)
Space Complexity: O(1)
"""

def trap_rain_water(height):
    if not height:
        return 0

    left = 0
    right = len(height) - 1
    left_max = 0
    right_max = 0
    water = 0

    while left < right:
        if height[left] < height[right]:
            if height[left] >= left_max:
                left_max = height[left]
            else:
                water += left_max - height[left]
            left += 1
        else:
            if height[right] >= right_max:
                right_max = height[right]
            else:
                water += right_max - height[right]
            right -= 1

    return water


# Example usage
arr = list(map(int, input("Enter height array: ").split()))
result = trap_rain_water(arr)

print("Total trapped rain water:", result)
